# Large binary captures — track CSV/JSON/TXT, ignore binary traces
captures/*.pml
captures/*.etl
captures/*.bl
captures/**/*.etl
captures/**/*.pdb
captures/**/events.csv
captures/**/report.xml
captures/**/*.NGENPDB/

# Archived experiment data (kept locally, not pushed)
captures/archive/

# Audit output (regenerated on each run)
captures/audits/*.json
captures/audits/*.html
captures/audits/*.ps1
captures/audits/history.csv

# OS artifacts
Thumbs.db
desktop.ini
.DS_Store

# Editor
.vscode/
*.code-workspace

# Temp and log files
*.tmp
*.cache
*.bak

# Node
node_modules/
package-lock.json

# Brainstorm sessions
.superpowers/

# Local captures (not tracked — regenerated per machine)
captures/backup_pre_*.txt
captures/backup_pre_*.reg
captures/backup_pre_*.json
captures/backup_dwm_*.reg
captures/backup_audio_*.txt
captures/backup_nic_*.txt
captures/backup_deconflict_*.txt
captures/experiments/

# Audit/BIOS/pipeline run outputs (regenerated each session)
captures/audit_output_*.txt
captures/audio_clock_diag_*.txt
captures/pipeline_output_*.txt
captures/bios_backup_*.txt
captures/bios_current.txt
captures/bios_current.txt.dup
captures/bios_export_*.txt
captures/bios_tier*_import.txt
captures/health_*/

# Full-suite baseline captures (large binaries; keep MASTER.html + manifest + entry small-file subset trackable if user commits)
captures/baselines/**/*.etl
captures/baselines/**/*.pml
captures/baselines/**/*.csv
captures/baselines/**/wpr_*_raw.txt
captures/baselines/**/xperf_*_raw.txt
captures/baselines/**/*.NGENPDB/
captures/baselines/**/audit_[0-9]*.html
captures/baselines/**/audit_[0-9]*.json
captures/.synthetic_load_state.json

# Playwright MCP scratch
.playwright-mcp/

# Claude scheduled task lockfile
.claude/scheduled_tasks.lock

# Third-party tools bundled locally (redistributable, not tracked)
p95v3019b20.win64/
ProcessMonitor/

# Historical archive zips (large, mirror preserved locally only)
docs/history/**/scripts_and_tools.zip
docs/history/**/*.zip

# Local settings
.claude/settings.local.json

# Chrome test profile (local browser data)
.chrome-test-profile/

# Registry watchdog snapshots (machine-specific, regenerated per run)
captures/registry_watchdog/

# Session captures and diagnostic traces (machine-specific, contain ETL/CSV data)
captures/sessions/
captures/fortnite_freeze_diag/

# Root-level stray artifacts (screenshots, ad-hoc HTML reports)
/*.png
/*.html

# Machine-specific runtime artifacts (regenerated per-machine, contain device IDs)
captures/startup_guard_log.txt
captures/defender_safemode/
captures/os_baseline_*.txt
captures/driver_audit_*.html
captures/driver_audit_*.json

# User-local Defender exclusions (contains machine-specific paths)
config/defender_exclusions.txt

# If you want to exclude large CSVs from the repo, uncomment:
# captures/*.csv
%windir%/
