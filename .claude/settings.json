{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(wc *)",
      "Bash(ls *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(powershell -ExecutionPolicy Bypass -File *)",
      "Bash(powershell -ExecutionPolicy Bypass -Command *)",
      "Bash(powershell -ExecutionPolicy Bypass -NonInteractive *)",
      "Bash(powershell -Command *)",
      "Bash(powershell -NonInteractive *)",
      "Bash(cargo *)",
      "Bash(nvidia-smi *)",
      "Bash(wpr *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -NonInteractive -File .claude/hooks/post-edit.ps1 -FilePath \"${file_path}\"",
            "timeout": 10000
          }
        ]
      }
    ],
    "PreCommit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -NonInteractive -File .claude/hooks/pre-commit.ps1",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
